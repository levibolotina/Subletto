# ─── DATABASE ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/subletto?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/subletto"   # Supabase direct (for migrations)

# ─── SUPABASE ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── CLERK ─────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."         # Svix webhook signing secret from Clerk Dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ─── STRIPE ────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe Connect (used for escrow payouts to listers — requires Connect onboarding)
STRIPE_CONNECT_ACCOUNT_ID=""   # lister's Connect account ID (future: per-lister)

# ─── RESEND ────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@subletto.co"

# ─── APP ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"   # Fastify API — used by client components
API_URL="http://localhost:3001"               # Internal server-to-server
API_SECRET="your-internal-api-secret"

# ─── NODE ──────────────────────────────────────────────────
NODE_ENV="development"

# ─── CRON ──────────────────────────────────────────────
CRON_SECRET="your-cron-secret"   # Sent as x-cron-secret header by scheduler

# ─── DOCUSIGN ──────────────────────────────────────────
# Create an integration key in your DocuSign developer account
DOCUSIGN_CLIENT_ID="your-integration-key"
# Found under Admin → Users → your admin user → API user ID
DOCUSIGN_USER_ID="your-user-guid"
# Found under Admin → My Account → Account ID
DOCUSIGN_ACCOUNT_ID="your-account-id"
# RSA private key from the integration key keypair (escape newlines as \n)
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Sandbox: https://demo.docusign.net/restapi  |  Production: https://www.docusign.net/restapi
DOCUSIGN_BASE_PATH="https://demo.docusign.net/restapi"
# Sandbox: account-d.docusign.com  |  Production: account.docusign.com
DOCUSIGN_OAUTH_BASE_PATH="account-d.docusign.com"

# ─── GROWTH / WAITLIST ──────────────────────────────────────
# No additional env vars required.
# Waitlist uses the existing DATABASE_URL + RESEND_API_KEY.
# After launch, set NEXT_PUBLIC_APP_URL to your production domain
# so waitlist referral links and sitemap URLs resolve correctly.

# ─── UPSTASH REDIS (rate limiting) ──────────────────────────
UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"
